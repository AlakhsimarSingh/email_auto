DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres   # direct/session-pooler URL for Prisma migrations
OWNER_EMAIL=alakhsimar8@gmail.com
OWNER_GOOGLE_SUB=            # pinned automatically on first successful owner Google sign-in
SESSION_SECRET=change-me-use-at-least-32-random-characters
TICK_SECRET=change-me-another-long-random-string
OTP_PEPPER=change-me-use-a-different-32-character-random-secret
APP_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
GMAIL_TOKEN_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GMAIL_REFRESH_TOKEN=            # Gmail OAuth refresh token; also delivers admin OTPs
DRY_RUN=true                    # keep true until you've reviewed real drafts
DAILY_CAP=10
PAGESPEED_API_KEY=            # optional; enables mobile performance/SEO/accessibility and compressed preview audits
COMPANIES_HOUSE_API_KEY=      # optional; UK company-name enrichment only, never used for contact data
TAVILY_API_KEY=               # optional; web search for published emails when the site crawl finds none (free: 1,000 credits/month)
TAVILY_MONTHLY_LIMIT=950      # stay under the free quota; paced evenly per day
HUNTER_API_KEY=               # optional; Hunter.io domain search for generic role addresses (free: 50 credits/month)
HUNTER_MONTHLY_LIMIT=45
DAILY_DRAFT_TARGET=15         # research pauses once this many drafts were created in the last 24 hours
SENDER_NAME=Your Name
POSTAL_ADDRESS=Your business postal address (required by CAN-SPAM)
LLM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint; blank key = template drafts
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_DAILY_TOKEN_BUDGET=30000
RECONTACT_COOLDOWN_DAYS=90
RECONTACT_MIN_P=0.01             # re-contact only when the estimated reply probability is at least this (1%)
RECONTACT_MAX_SEQUENCES=3        # first outreach + up to 2 re-contacts per business
RECONTACT_FORGET_DAYS=60         # "tau": how fast a past email is forgotten in the re-contact decay formula
BRAIN_STRATEGIST_LLM=false       # true = the weekly strategist may send anonymized edit samples to your LLM provider (budgeted)
LLM_STRATEGIST_MODEL=            # optional larger model for the strategist; blank uses LLM_MODEL
SEND_HOLD_MINUTES=30
PORTFOLIO_PROJECTS=
VAPID_PUBLIC_KEY=               # generate with: corepack pnpm --filter @outreach/backend exec web-push generate-vapid-keys --json
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=               # set to a mailto: contact address when Web Push is configured
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BACKEND_PUBLIC_URL=           # public HTTPS backend origin; needed to link Telegram
NOTIFICATION_TIMEZONE=Asia/Kolkata
NOTIFICATION_DIGEST_TIME=08:30
NOTIFICATION_ESCALATION_MINUTES=15
WARMUP_RAMP=3,5,7,10
WARMUP_RAMP_DAYS=7
SUPABASE_DB_LIMIT_MB=500
