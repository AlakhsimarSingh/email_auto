generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  role                   String                  @default("admin")
  googleSub              String?                 @unique @map("google_sub")
  addedBy                String?                 @map("added_by")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions               AuthSession[]
  passkeys               PasskeyCredential[]
  challenges             PasskeyChallenge[]
  pushDevices            PushDevice[]
  notificationChannels   NotificationChannel[]
  notificationLinkTokens NotificationLinkToken[]
  seedTests              SeedTestRecord[]

  @@map("admin_users")
}

model AuthOtp {
  id            String    @id @db.Uuid
  email         String
  codeHmac      String    @map("code_hmac")
  requestIpHash String    @map("request_ip_hash")
  attempts      Int       @default(0)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([requestIpHash, createdAt])
  @@map("auth_otps")
}

model AuthOtpRequest {
  id            String   @id @db.Uuid
  emailHash     String   @map("email_hash")
  requestIpHash String   @map("request_ip_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([emailHash, createdAt])
  @@index([requestIpHash, createdAt])
  @@map("auth_otp_requests")
}

model AuthSession {
  id          String       @id @db.Uuid
  adminUserId Int          @map("admin_id")
  deviceLabel String       @map("device_label")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  stepUpUntil DateTime?    @map("step_up_until") @db.Timestamptz(6)
  adminUser   AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  pushDevices PushDevice[]

  @@index([adminUserId, revokedAt])
  @@map("auth_sessions")
}

model PasskeyCredential {
  id          String    @id @map("credential_id")
  adminUserId Int       @map("admin_id")
  publicKey   Bytes     @map("public_key")
  counter     BigInt    @default(0)
  transports  String[]  @default([])
  deviceType  String    @map("device_type")
  backedUp    Boolean   @default(false) @map("backed_up")
  label       String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id            String     @id @db.Uuid
  challenge     String     @unique
  purpose       String
  adminUserId   Int?       @map("admin_id")
  sessionId     String?    @map("session_id") @db.Uuid
  requestIpHash String     @map("request_ip_hash")
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?  @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([requestIpHash, createdAt])
  @@map("passkey_challenges")
}

model PushDevice {
  id              String                 @id @default(uuid()) @db.Uuid
  adminUserId     Int                    @map("admin_id")
  sessionId       String                 @map("session_id") @db.Uuid
  label           String
  endpoint        String                 @unique
  p256dh          String
  auth            String
  enabled         Boolean                @default(true)
  isPrimary       Boolean                @default(false) @map("is_primary")
  muted           Boolean                @default(false)
  quietStart      String?                @map("quiet_start")
  quietEnd        String?                @map("quiet_end")
  notifyReplies   Boolean                @default(true) @map("notify_replies")
  notifyPlans     Boolean                @default(true) @map("notify_plans")
  notifyDigest    Boolean                @default(true) @map("notify_digest")
  digestFrequency String                 @default("daily") @map("digest_frequency")
  lastSeenAt      DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastTestAt      DateTime?              @map("last_test_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  adminUser       AdminUser              @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  session         AuthSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveries      NotificationDelivery[]

  @@index([adminUserId, enabled])
  @@index([sessionId])
  @@map("push_devices")
}

model NotificationChannel {
  id               String                 @id @default(uuid()) @db.Uuid
  adminUserId      Int                    @map("admin_id")
  type             String
  label            String
  targetHash       String                 @map("target_hash")
  targetCiphertext Bytes                  @map("target_ciphertext")
  targetIv         Bytes                  @map("target_iv")
  targetAuthTag    Bytes                  @map("target_auth_tag")
  enabled          Boolean                @default(true)
  isPrimary        Boolean                @default(false) @map("is_primary")
  muted            Boolean                @default(false)
  quietStart       String?                @map("quiet_start")
  quietEnd         String?                @map("quiet_end")
  notifyReplies    Boolean                @default(true) @map("notify_replies")
  notifyPlans      Boolean                @default(true) @map("notify_plans")
  notifyDigest     Boolean                @default(true) @map("notify_digest")
  digestFrequency  String                 @default("daily") @map("digest_frequency")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  adminUser        AdminUser              @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  deliveries       NotificationDelivery[]

  @@unique([adminUserId, type, targetHash])
  @@index([adminUserId, enabled])
  @@map("notification_channels")
}

model NotificationLinkToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId Int       @map("admin_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("notification_link_tokens")
}

model WorkspaceNotification {
  id             String                 @id @default(uuid()) @db.Uuid
  eventKey       String                 @unique @map("event_key")
  priority       Int
  title          String
  body           String
  eventType      String                 @map("event_type")
  url            String
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?              @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?                @map("acknowledged_by")
  escalatedAt    DateTime?              @map("escalated_at") @db.Timestamptz(6)
  deliveries     NotificationDelivery[]

  @@index([priority, acknowledgedAt, createdAt])
  @@map("workspace_notifications")
}

model NotificationDelivery {
  id                String                @id @default(uuid()) @db.Uuid
  idempotencyKey    String                @unique @map("idempotency_key")
  notificationId    String                @map("notification_id") @db.Uuid
  deviceId          String?               @map("device_id") @db.Uuid
  channelId         String?               @map("channel_id") @db.Uuid
  status            String                @default("pending")
  attempts          Int                   @default(0)
  externalMessageId String?               @map("external_message_id")
  lastError         String?               @map("last_error")
  lastAttemptAt     DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(6)
  notification      WorkspaceNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device            PushDevice?           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  channel           NotificationChannel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([notificationId, status])
  @@map("notification_deliveries")
}

model SeedTestRecord {
  id              String    @id @default(uuid()) @db.Uuid
  adminUserId     Int       @map("admin_id")
  emailHash       String    @map("email_hash")
  mailboxProvider String    @map("mailbox_provider")
  placement       String
  testedAt        DateTime  @default(now()) @map("tested_at") @db.Timestamptz(6)
  adminUser       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, testedAt])
  @@index([testedAt])
  @@map("seed_test_records")
}

model GmailOAuthState {
  id          String    @id @db.Uuid
  stateHash   String    @unique @map("state_hash")
  adminUserId Int       @map("admin_id")
  sessionId   String    @map("session_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("gmail_oauth_states")
}

model IntegrationSecret {
  id         String   @id
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes    @map("auth_tag")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("integration_secrets")
}

model AppSetting {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorEmail String   @map("actor_email")
  action     String
  target     String?
  meta       Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("audit_log")
}

model Campaign {
  id             Int       @id @default(autoincrement())
  name           String?
  niche          String?
  city           String?
  country        String?
  osmFilter      String    @map("osm_filter")
  active         Boolean?  @default(true)
  lastSearchedAt DateTime? @map("last_searched_at") @db.Timestamptz(6)

  @@map("campaigns")
}

model Market {
  code                  String    @id @db.VarChar(2)
  name                  String
  enabled               Boolean   @default(false)
  clientValueScore      Int       @default(50) @map("client_value_score")
  leadSupplyScore       Int       @default(50) @map("lead_supply_score")
  emailYieldScore       Int       @default(50) @map("email_yield_score")
  responseScore         Int       @default(50) @map("response_score")
  communicationFitScore Int       @default(50) @map("communication_fit_score")
  compliancePenalty     Int       @default(5) @map("compliance_penalty")
  gdpPppPerCapita       Float?    @map("gdp_ppp_per_capita")
  gdpReferenceYear      Int?      @map("gdp_reference_year")
  gdpUpdatedAt          DateTime? @map("gdp_updated_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("markets")
}

model CityGeoCache {
  id          String   @id
  latitude    Float
  longitude   Float
  osmType     String?  @map("osm_type")
  osmId       String?  @map("osm_id")
  displayName String?  @map("display_name")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("city_geo_cache")
}

model Business {
  id                  Int       @id @default(autoincrement())
  osmId               String?   @unique @map("osm_id")
  name                String?
  niche               String?
  city                String?
  country             String?
  websiteUrl          String?   @map("website_url")
  track               String    @default("site")
  phone               String?
  latitude            Float?
  longitude           Float?
  timezone            String?
  socialOnly          Boolean   @default(false) @map("social_only")
  score               Int?
  scoreSignals        Json?     @map("score_signals") @db.JsonB
  osmTags             Json?     @map("osm_tags") @db.JsonB
  callScript          String?   @map("call_script")
  auditedAt           DateTime? @map("audited_at") @db.Timestamptz(6)
  screenshot          Bytes?
  screenshotExpiresAt DateTime? @map("screenshot_expires_at") @db.Timestamptz(6)
  status              String?   @default("new")
  findings            Json?     @db.JsonB
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  contacts            Contact[]
  emails              Email[]
  deal                Deal?

  @@map("businesses")
}

model Contact {
  id         Int       @id @default(autoincrement())
  businessId Int?      @map("business_id")
  email      String?
  sourceUrl  String?   @map("source_url")
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  emails     Email[]

  @@unique([businessId, email])
  @@map("contacts")
}

model Email {
  id               Int            @id @default(autoincrement())
  businessId       Int?           @map("business_id")
  contactId        Int?           @map("contact_id")
  subject          String?
  origSubject      String?        @map("orig_subject")
  body             String?
  origBody         String?        @map("orig_body")
  manualRequired   Boolean        @default(false) @map("manual_required")
  draftAngle       String?        @map("draft_angle")
  portfolioProject String?        @map("portfolio_project")
  draftConfidence  Float?         @map("draft_confidence")
  status           String?        @default("drafted")
  holdUntil        DateTime?      @map("hold_until") @db.Timestamptz(6)
  scheduledFor     DateTime?      @map("scheduled_for") @db.Timestamptz(6)
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz(6)
  gmailMessageId   String?        @map("gmail_message_id")
  gmailThreadId    String?        @map("gmail_thread_id")
  rfcMessageId     String?        @map("rfc_message_id")
  sequenceStep     Int            @default(0) @map("sequence_step")
  followUpDueAt    DateTime?      @map("follow_up_due_at") @db.Timestamptz(6)
  error            String?
  learnedAt        DateTime?      @map("learned_at") @db.Timestamptz(6)
  learnOutcome     String?        @map("learn_outcome")
  selectionInfo    Json?          @map("selection_info") @db.JsonB
  createdAt        DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  business         Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sendPlanItems    SendPlanItem[]
  replyRecords     ReplyRecord[]
  draftEdit        DraftEdit?

  @@map("emails")
}

model Deal {
  id         Int      @id @default(autoincrement())
  businessId Int      @unique @map("business_id")
  stage      String   @default("replied")
  valueCents Int      @default(0) @map("value_cents")
  currency   String   @default("USD") @db.VarChar(3)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([stage, updatedAt])
  @@map("deals")
}

model SendPlan {
  id          String         @id @db.Uuid
  state       String         @default("draft")
  announcedAt DateTime?      @map("announced_at") @db.Timestamptz(6)
  startsAt    DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime       @map("ends_at") @db.Timestamptz(6)
  vetoedAt    DateTime?      @map("vetoed_at") @db.Timestamptz(6)
  frozenAt    DateTime?      @map("frozen_at") @db.Timestamptz(6)
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  items       SendPlanItem[]

  @@index([state, startsAt, endsAt])
  @@map("send_plans")
}

model SendPlanItem {
  id         Int      @id @default(autoincrement())
  sendPlanId String   @map("send_plan_id") @db.Uuid
  emailId    Int      @unique @map("email_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sendPlan   SendPlan @relation(fields: [sendPlanId], references: [id], onDelete: Cascade)
  email      Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([sendPlanId, emailId])
  @@index([sendPlanId])
  @@map("send_plan_items")
}

model GmailSyncState {
  id           Int       @id
  historyId    String?   @map("history_id")
  lastPolledAt DateTime? @map("last_polled_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("gmail_sync_state")
}

model ReplyRecord {
  id             Int       @id @default(autoincrement())
  gmailMessageId String    @unique @map("gmail_message_id")
  threadId       String    @map("thread_id")
  emailId        Int?      @map("email_id")
  email          Email?    @relation(fields: [emailId], references: [id], onDelete: SetNull)
  classification String
  snippet        String?
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  handledAt      DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([classification, handledAt, receivedAt])
  @@index([emailId])
  @@map("reply_records")
}

model Suppression {
  email     String    @id
  reason    String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("suppressions")
}

model UnsubscribeToken {
  tokenHash String   @id @map("token_hash")
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("unsubscribe_tokens")
}

model ContactLedger {
  email          String    @id
  domain         String
  businessId     Int?      @map("business_id")
  status         String    @default("eligible")
  firstContactAt DateTime? @map("first_contact_at") @db.Timestamptz(6)
  lastContactAt  DateTime? @map("last_contact_at") @db.Timestamptz(6)
  eligibleAfter  DateTime? @map("eligible_after") @db.Timestamptz(6)
  contactCount   Int       @default(0) @map("contact_count")
  blockReason    String?   @map("block_reason")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([domain, status])
  @@index([eligibleAfter])
  @@map("contact_ledger")
}

model DomainLock {
  domain      String   @id
  businessId  Int?     @map("business_id")
  lastSentAt  DateTime @map("last_sent_at") @db.Timestamptz(6)
  lockedUntil DateTime @map("locked_until") @db.Timestamptz(6)

  @@index([lockedUntil])
  @@map("domain_locks")
}

model DailyTokenUsage {
  day         DateTime @id @db.Date
  totalTokens Int      @default(0) @map("total_tokens")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("daily_token_usage")
}

model Lease {
  id    Int      @id
  until DateTime @db.Timestamptz(6)

  @@map("lease")
}

model AgentMemory {
  id               Int       @id @default(autoincrement())
  kind             String
  scope            Json      @default("{}") @db.JsonB
  text             String
  source           String
  confidence       Float     @default(1)
  evidenceCount    Int       @default(0) @map("evidence_count")
  active           Boolean   @default(true)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  lastReinforcedAt DateTime  @default(now()) @map("last_reinforced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([active, kind])
  @@map("agent_memory")
}

model AgentArm {
  id        Int      @id @default(autoincrement())
  dimension String
  key       String
  successes Float    @default(0)
  failures  Float    @default(0)
  n         Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dimension, key])
  @@map("agent_arms")
}

model AgentFeedback {
  id         Int      @id @default(autoincrement())
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  score      Int
  note       String?
  effect     Float    @default(0)
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("agent_feedback")
}

model AgentProposal {
  id        Int       @id @default(autoincrement())
  kind      String
  summary   String
  rationale String
  patch     Json      @default("{}") @db.JsonB
  dedupeKey String    @map("dedupe_key")
  status    String    @default("pending")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy String?   @map("decided_by")

  @@index([status, createdAt])
  @@index([dedupeKey])
  @@map("agent_proposals")
}

model AgentModel {
  id        Int      @id @default(autoincrement())
  kind      String
  version   Int
  params    Json     @db.JsonB
  trainedOn Int      @map("trained_on")
  metrics   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, version])
  @@map("agent_models")
}

model DraftEdit {
  id           Int      @id @default(autoincrement())
  emailId      Int      @unique @map("email_id")
  diff         Json     @db.JsonB
  editDistance Int      @map("edit_distance")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  email        Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("draft_edits")
}

model ResetSnapshot {
  id           Int       @id @default(autoincrement())
  kind         String    @default("reset")
  payload      Json      @db.JsonB
  counts       Json      @db.JsonB
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  restoreUntil DateTime  @map("restore_until") @db.Timestamptz(6)
  restoredAt   DateTime? @map("restored_at") @db.Timestamptz(6)

  @@index([restoreUntil])
  @@map("reset_snapshots")
}
