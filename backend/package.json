{
  "name": "@outreach/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "test": "tsx --test src/companies-house.test.ts src/reply-classification.test.ts src/portfolio.test.ts src/push.test.ts src/warmup.test.ts src/notifications.test.ts src/scheduling.test.ts src/brain-math.test.ts src/analytics-extra.test.ts src/usage-meter.test.ts",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy && tsx src/migrate.ts",
    "preflight": "tsx src/preflight.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@simplewebauthn/server": "13.2.2",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "sharp": "^0.35.5",
    "tz-lookup": "^6.1.25",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tz-lookup": "^6.1.2",
    "@types/web-push": "^3.6.4",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
